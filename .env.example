# Copy to .env for local development and supply your own MongoDB connection URI.
# Placeholder only: replace before starting. Never commit real credentials.
MONGO_URI=<your-mongodb-connection-string>
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated exact HTTP(S) origins, without paths or trailing slashes.
# Empty disables cross-origin browser access. Credentialed browser requests require an exact allowed origin.
ALLOWED_ORIGINS=http://localhost:3001
# Unauthenticated Gym/Branch bootstrap API: development only, disabled by default.
# Startup rejects this flag in staging/production. Main API never mounts bootstrap routes.
# Separate loopback-only port: never expose or forward it through a reverse proxy.
BOOTSTRAP_PORT=3002
ENABLE_BOOTSTRAP_ROUTES=false
# Require 32–64 cryptographically random bytes encoded as 64–128 hex characters.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Placeholder is intentionally invalid. Never commit the generated value.
JWT_ACCESS_SECRET=<generate-a-strong-random-secret>
JWT_ISSUER=gym-management-api
JWT_AUDIENCE=gym-management-client
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=604800
SESSION_TTL_SECONDS=2592000

# Optional member photo storage. Leave all empty until configured. Backend only.
# Set these locally from Cloudinary Console; never copy them into Flutter.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional VPS reverse-proxy topology. Leave unset to preserve existing binding/trust.
# On a same-host Nginx VPS, bind privately and trust ONLY its real source addresses.
# API_BIND_HOST=127.0.0.1
# TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Optional Gmail recovery delivery: use an app password, never the mailbox password.
# No delivery is enabled until all fields are supplied privately. Never send secrets in chat.
RECOVERY_SMTP_USER=pcterajbca7772@gmail.com
RECOVERY_EMAIL_FROM=pcterajbca7772@gmail.com
RECOVERY_SMTP_PASSWORD=
RECOVERY_TOKEN_TTL_SECONDS=900

# Account deletion: disabled = request intake only; operator = intake plus the
# operator-reviewed fulfillment worker (release setting); enabled = self-service.
# operator/enabled require the Gmail delivery fields above and a private notice key:
# generate with `openssl rand -hex 32` on the server; never commit it.
ACCOUNT_DELETION_AUTOMATION=disabled
ACCOUNT_DELETION_NOTICE_KEY=
